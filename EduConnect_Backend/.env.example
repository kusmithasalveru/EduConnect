# Copy this file to `.env` for local development and fill in real values.
# Never commit the real `.env` file - it is excluded via .gitignore.
#
# Spring Boot does not load .env files natively. Either:
#   1) export these as real shell environment variables before running the
#      app (e.g. `export $(cat .env | xargs)` on Linux/Mac), or
#   2) use an IDE run configuration / a tool like `direnv` to load them, or
#   3) pass them as -D system properties / --key=value args to the jar.

# --- Server ---
PORT=8080

# --- Database (PostgreSQL) ---
# Local dev default (matches application.yml fallback) is a local Postgres
# instance named educonnect_backend with user/pass "postgres"/"postgres".
# In production (Render), set these to the real managed Postgres connection
# details - never reuse local credentials in production.
DB_URL=jdbc:postgresql://localhost:5432/educonnect_backend
DB_USERNAME=<your-local-postgres-username>
DB_PASSWORD=<your-local-postgres-password>

# --- JWT ---
# Required. The app will fail to start without this.
# Generate a strong secret locally with: openssl rand -base64 32
JWT_SECRET=<set-your-own-base64-secret-min-32-bytes>
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of allowed frontend origins. Defaults to local dev
# origins if unset. In production, set this to the real deployed frontend
# URL(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://educonnect-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
